<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="800dp"
    android:layout_height="720dp">

    <GridLayout
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="8"
        android:orientation="vertical"
        android:rowCount="8">

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_rowSpan="3"
            android:layout_columnSpan="2"
            android:background="@android:color/holo_orange_dark"
            android:orientation="vertical"
            android:rowCount="3">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:text="@string/paidin"
                android:textColor="@android:color/black"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:text="@string/paidout"
                android:textColor="@android:color/black"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:text="@string/balance"
                android:textColor="@android:color/black"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/TotalPaidInUSD"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_column="1"
                android:textAlignment="textEnd"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/TotalPaidOutUSD"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_column="1"
                android:textAlignment="textEnd"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/TotalBalanceUSD"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_column="1"
                android:textAlignment="textEnd"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/TotalPaidInEUR"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_column="2"
                android:textAlignment="textEnd"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/TotalPaidOutEUR"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_column="2"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/TotalBalanceEUR"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_column="2"
                android:textAlignment="textEnd"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/TotalPaidInGBP"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_column="3"
                android:textAlignment="textEnd"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/TotalPaidOutGBP"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_column="3"
                android:textAlignment="textEnd"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/TotalBalanceGBP"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_column="3"
                android:textAlignment="textEnd"
                android:textSize="17sp" />
        </GridLayout>

        <Button
            android:id="@+id/Submit"
            android:layout_width="100dp"
            android:layout_height="20dp"
            android:layout_row="1"
            android:layout_column="0"
            android:background="@android:color/holo_orange_light"
            android:text="@string/submit"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_gravity="end"
            android:text="@string/institution"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_gravity="end"
            android:text="@string/provider"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_gravity="end"
            android:text="@string/account"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="5"
            android:layout_column="0"
            android:layout_gravity="end"
            android:text="@string/transactions"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/NextConnectionMessage"
            android:layout_width="100dp"
            android:layout_height="20dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_gravity="start"
            android:background="@android:color/white"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/Institutions"
            android:layout_width="185dp"
            android:layout_height="25dp"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_columnSpan="2"
            android:background="@android:color/white"/>


        <SmartCubeMobile.MultiSpinner
            android:id="@+id/providerSpinner"
            android:layout_width="185dp"
            android:layout_height="25dp"
            android:layout_row="3"
            android:layout_column="1"
            android:background="@android:color/white"/>


        <SmartCubeMobile.MultiSpinner
            android:id="@+id/accountSpinner"
            android:layout_width="185dp"
            android:layout_height="25dp"
            android:layout_row="4"
            android:layout_column="1"
            android:background="@android:color/white"/>

        <SmartCubeMobile.MultiSpinner
            android:id="@+id/transactionsSpinner"
            android:layout_width="185dp"
            android:layout_height="20dp"
            android:layout_row="5"
            android:layout_column="1"
            android:background="@android:color/white"/>

        <Button
            android:id="@+id/Cancel"
            android:layout_width="100dp"
            android:layout_height="20dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_gravity="end"
            android:background="@android:color/holo_red_light"
            android:text="@string/cancel"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_gravity="end"
            android:text="@string/area"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_gravity="end"
            android:text="@string/sortcode"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_row="4"
            android:layout_column="1"
            android:layout_gravity="end"
            android:text="@string/accountno"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_row="5"
            android:layout_column="1"
            android:layout_gravity="end"
            android:text="@string/ledswitch"
            android:textSize="15sp" />
        <!-- End of Column 1-->

        <!--Start of Column 2-->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="2"
            android:rowCount="3"
            android:columnCount="2"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/RBBanks"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_row="0"
                android:layout_column="0"
                android:tag="@string/b"
                android:textSize="15sp" />

            <ImageView
                android:contentDescription="@string/cashsymbol"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_row="0"
                android:layout_column="1"
                android:src="@drawable/cashbag" />

            <RadioButton
                android:id="@+id/RBSavings"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_row="1"
                android:layout_column="0"
                android:tag="@string/s"
                android:textSize="15sp" />

            <ImageView
                android:contentDescription="@string/savingssymbol"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_row="1"
                android:layout_column="1"
                android:src="@drawable/piggybank" />

            <RadioButton
                android:id="@+id/RBInvestments"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_row="2"
                android:layout_column="0"
                android:tag="@string/i"
                android:textSize="15sp" />

            <ImageView
                android:contentDescription="@string/investmentssymbol"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_row="2"
                android:layout_column="1"
                android:src="@drawable/stockmarket" />
        </GridLayout>

        <TextView
            android:id="@+id/AreaIdDynamic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="2"
            android:textAlignment="center"
            android:textSize="15sp"
            android:background="@android:color/white"/>

        <TextView
            android:id="@+id/SortCodeDynamic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="3"
            android:layout_column="2"
            android:textAlignment="center"
            android:textSize="15sp"
            android:background="@android:color/white"/>

        <TextView
            android:id="@+id/AccountNoDynamic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="4"
            android:layout_column="2"
            android:textAlignment="center"
            android:textSize="15sp"
            android:background="@android:color/white"/>


        <TextView
            android:id="@+id/LedSwitched"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_row="5"
            android:layout_column="2"
            android:text="@string/switched"
            android:textAlignment="center"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="15sp" />


        <!-- End of Column 2-->

        <!-- Start of Column 3-->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="5"
            android:layout_rowSpan="2"
            android:layout_columnSpan="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_gravity="center"
                android:text="@string/address"
                android:textAlignment="center"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/Addresses"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_gravity="center"
                android:textAlignment="center" />
        </GridLayout>

        <!-- Start of column 4-->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="5"
            android:layout_rowSpan="2"
            android:layout_columnSpan="1"
            android:columnCount="3"
            android:rowCount="2"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_gravity="center"
                android:text="@string/startdate"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="2"
                android:layout_gravity="center"
                android:text="@string/enddate"
                android:textSize="15sp" />

            <DatePicker
                android:id="@+id/StartingDate"
                android:layout_width="50dp"
                android:layout_height="15dp"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_gravity="center"/>

            <Button
                android:id="@+id/ResetDates"
                android:layout_width="50dp"
                android:layout_height="15dp"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_gravity="center"
                android:background="@android:color/holo_blue_bright"
                android:text="@string/reset" />

            <DatePicker
                android:id="@+id/EndingDate"
                android:layout_width="50dp"
                android:layout_height="15dp"
                android:layout_row="1"
                android:layout_column="2"
                android:layout_gravity="center" />

        </GridLayout>

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="4"
            android:layout_rowSpan="2"
            android:layout_column="5"
            android:layout_columnSpan="2"
            android:columnCount="2"
            android:rowCount="2"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_gravity="center"
                android:layout_columnWeight="1"
                android:text="@string/totaltrans"
                android:textAlignment="center"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_gravity="center"
                android:layout_columnWeight="1"
                android:text="@string/totalvalue"
                android:textAlignment="center"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/TotalTransactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_gravity="center"
                android:layout_columnWeight="1"
                android:background="@android:color/white"
                android:textAlignment="center"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/TotalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_gravity="center"
                android:layout_columnWeight="1"
                android:background="@android:color/white"
                android:textAlignment="center"
                android:textSize="15sp" />

        </GridLayout>

        <!-- Start of Column 5-->
        <GridLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="7"
            android:layout_rowSpan="8"
            android:rowCount="10">

            <ImageView
                android:id="@+id/pictureBoxLOGO"
                android:background="@android:color/transparent"
                android:layout_height="30dp"
                android:layout_width="match_parent"
                android:layout_row="0"
                android:layout_column="0"
                android:contentDescription="@string/institutionlogo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_gravity="center"
                android:text="@string/postcode"
                android:textSize="15sp"
                android:background="@android:color/white"/>

            <TextView
                android:id="@+id/Postcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_gravity="center"
                android:background="@android:color/white"
                android:textSize="15sp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="3"
                android:layout_column="0"
                android:layout_gravity="center"
                android:background="#ffff00"
                android:text="@string/displaycultures"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/financeCultures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="4"
                android:layout_column="0"
                android:background="@android:color/white"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="5"
                android:layout_column="0"
                android:layout_gravity="center"
                android:background="#ffff00"
                android:text="@string/conversionrates"
                android:textSize="15sp" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_row="6"
                android:layout_column="0"
                android:layout_rowSpan="2">
                <RadioButton
                    android:id="@+id/RBGBP"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textSize="12sp"
                    android:tag="@string/GBP"
                    android:text="@string/GBP"
                    android:background="@android:color/white"/>
                <RadioButton
                    android:id="@+id/RBEUR"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textSize="12sp"
                    android:tag="@string/EUR"
                    android:text="@string/EUR"
                    android:background="@android:color/white"/>
                <RadioButton
                    android:id="@+id/RBUSD"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textSize="12sp"
                    android:tag="@string/USD"
                    android:text="@string/USD"
                    android:background="@android:color/white"/>
                <RadioButton
                    android:id="@+id/RBJPY"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textSize="12sp"
                    android:tag="@string/JPY"
                    android:text="@string/JPY"
                    android:background="@android:color/white"/>
            </RadioGroup>
        </GridLayout>
    </GridLayout>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/financetabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabBackground="@android:color/holo_orange_light"
            app:tabGravity="start"
            app:tabIndicatorAnimationMode="linear"
            app:tabIndicatorColor="#EF0C4C"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="2dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="#EF0C4C"
            app:tabTextAppearance="@style/TabTextAppearance" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/financeviewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/holo_green_light"
        app:layout_constraintGuide_begin="-18dp" />
</androidx.constraintlayout.widget.ConstraintLayout>