<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.Dashboard.InvestmentDetailPage"
             BackgroundColor="{StaticResource PageBg}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource NavBg}"
                Stroke="{StaticResource BorderColor}" StrokeThickness="0,0,0,1"
                Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="BackButton" Text="←" BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}" FontSize="20"
                        Padding="0" WidthRequest="40" HeightRequest="40"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="HeaderSymbol" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label x:Name="HeaderName" FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                <Label x:Name="HeaderType" Grid.Column="2"
                       FontSize="10" VerticalOptions="Center"
                       Padding="8,4" />
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20,16">
            <VerticalStackLayout Spacing="16">

                <!-- Price & PNL summary -->
                <Border Style="{StaticResource CardFrame}" Padding="20">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="20">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Current Price" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label x:Name="CurrentPrice" FontSize="24" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Market Value" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label x:Name="MarketValue" FontSize="24" FontAttributes="Bold"
                                   TextColor="{StaticResource Accent}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Spacing="2">
                            <Label Text="Total Cost" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label x:Name="TotalCost" FontSize="16"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="Total P&amp;L" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label x:Name="TotalPnl" FontSize="16" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Spacing="2">
                            <Label Text="Shares Held" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label x:Name="SharesHeld" FontSize="16"
                                   TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                            <Label Text="Dividend Yield" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label x:Name="DivYield" FontSize="16"
                                   TextColor="{StaticResource Success}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Chart -->
                <Border Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Price History" Style="{StaticResource Heading2}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4"
                                                   x:Name="PeriodButtons" />
                        </Grid>
                        <GraphicsView x:Name="ChartView"
                                      HeightRequest="200"
                                      HorizontalOptions="Fill" />
                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                            <Label x:Name="ChartLow" TextColor="{StaticResource TextMuted}" FontSize="10" />
                            <Label x:Name="ChartHigh" TextColor="{StaticResource TextMuted}" FontSize="10"
                                   HorizontalTextAlignment="End" Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Purchase history -->
                <Border Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Purchase History" Style="{StaticResource Heading2}" />
                        <VerticalStackLayout x:Name="PurchaseList" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
