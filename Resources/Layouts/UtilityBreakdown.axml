<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"    
    android:background="@android:color/white">
    
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="From Date"
            android:id="@+id/headingFromDate"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="To Date"
            android:id="@+id/headingToDate"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
    <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Code"
            android:id="@+id/headingCode"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Description"
            android:id="@+id/headingDescription"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Items"
            android:id="@+id/headingItems"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Charges/Discounts"
            android:id="@+id/headingChargesDiscounts"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Day Units"
            android:id="@+id/headingDayUnits"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Day Rate"
            android:id="@+id/headingDayRate"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Night Units"
            android:id="@+id/headingNightUnits"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Night Rate"
            android:id="@+id/headingNightRate"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Total Units"
            android:id="@+id/headingTotalUnits"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Total"
            android:id="@+id/headingTotal"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
    </LinearLayout>

    <FrameLayout
        android:background="@android:color/holo_blue_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.recyclerview.widget.RecyclerView 
            android:background="@android:color/white"        
            android:id="@+id/utilityBreakdown"      
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
    
</LinearLayout>