<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.Dashboard.ExchangeDetailPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" BackgroundColor="{StaticResource NavBg}" Padding="20,16"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" Text="← Back" BackgroundColor="Transparent"
                        TextColor="{StaticResource Accent}" FontSize="14"
                        ToolTipProperties.Text="Go back to the previous screen."
                        Clicked="OnBackClicked" Padding="0" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <Label x:Name="HeaderTitle" TextColor="{StaticResource TextPrimary}"
                           FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="HeaderSubtitle" TextColor="{StaticResource TextMuted}"
                           FontSize="11" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Button Grid.Column="3" Text="?" ToolTipProperties.Text="What this section does" FontSize="12" FontAttributes="Bold" WidthRequest="26" HeightRequest="26" Padding="0" CornerRadius="13" BackgroundColor="#1E2D4A" TextColor="#94A3B8" VerticalOptions="Center" Clicked="OnHelpClicked" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="20,12">
            <VerticalStackLayout Spacing="16">

                <!-- Total Value Card -->
                <Border Style="{StaticResource CardFrame}" Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="TotalValue" TextColor="{StaticResource TextPrimary}"
                               FontSize="32" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Assets" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="0" x:Name="AssetCount" TextColor="{StaticResource TextPrimary}" FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Transfers with your wallets" TextColor="{StaticResource TextMuted}" FontSize="11" ToolTipProperties.Text="Coins moved between this exchange and your own wallets. They aren't buys or sells; profit and loss is shown for your whole portfolio on the Crypto page." />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="TotalPnl" FontSize="14" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Transaction History -->
                <Border Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Transaction History" Style="{StaticResource Heading2}" ToolTipProperties.Text="Every transaction across all assets held on this exchange or wallet; use the buttons below to filter or export as PDF." />
                            <Label Grid.Column="1" x:Name="TxCountLabel" TextColor="{StaticResource TextMuted}" FontSize="12"
                                   VerticalOptions="Center" />
                        </Grid>
                        <HorizontalStackLayout x:Name="FilterBar" Spacing="8" />
                        <ScrollView Orientation="Horizontal">
                            <VerticalStackLayout x:Name="TransactionsList" Spacing="4"
                                                 MinimumWidthRequest="700" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- Asset List -->
                <VerticalStackLayout x:Name="AssetList" Spacing="10" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
