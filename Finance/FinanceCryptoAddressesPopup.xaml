<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.FinanceCryptoAddressesPopup"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Grid.Row="0" Padding="0,8,0,16">
            <Label Text="Crypto Addresses"
                   Style="{StaticResource Heading2}"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Close"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnCloseClicked" />
        </Grid>

        <!-- Card -->
        <Border Grid.Row="1"
                Style="{StaticResource CardFrame}"
                BackgroundColor="{StaticResource CardBg}"
                Stroke="{StaticResource BorderColor}"
                StrokeShape="RoundRectangle 12"
                Padding="12">
            <CollectionView ItemsSource="{Binding Addresses}">
                <CollectionView.EmptyView>
                    <Label Text="No crypto addresses found."
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource CardBgLight}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,4">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Address}"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

    </Grid>
</ContentPage>
