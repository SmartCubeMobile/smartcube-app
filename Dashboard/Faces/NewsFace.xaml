<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.Dashboard.Faces.NewsFace">
    <ScrollView>
    <VerticalStackLayout Spacing="12" Padding="20">

        <Border x:Name="NewsCard" Style="{StaticResource CardFrame}" Padding="16" Opacity="0">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <Label Text="Latest Market News" Style="{StaticResource Heading2}" />
                    <ActivityIndicator x:Name="NewsSpinner" Grid.Column="1"
                                       IsRunning="True" IsVisible="True"
                                       Color="#60A5FA" HeightRequest="18" WidthRequest="18"
                                       VerticalOptions="Center" />
                    <Button x:Name="RefreshNewsBtn" Grid.Column="2"
                            Text="&#x1F504;"
                            FontSize="14"
                            BackgroundColor="Transparent"
                            TextColor="#60A5FA"
                            Padding="4"
                            HeightRequest="32" WidthRequest="32"
                            VerticalOptions="Center"
                            Clicked="OnRefreshNewsClicked" />
                </Grid>
                <VerticalStackLayout x:Name="NewsList" Spacing="0" />
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
    </ScrollView>
</ContentView>
