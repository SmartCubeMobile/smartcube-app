<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.Dashboard.SwitchSupplierFlow"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- Header -->
        <Border BackgroundColor="{StaticResource NavBg}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="0,0,0,1"
                Padding="24,14">
            <Grid ColumnDefinitions="Auto,*">
                <Button x:Name="BackButton" Text="← Back"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="13" Padding="8,4"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <Label x:Name="PageTitle" Text="Switch Supplier"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" />
                    <Label x:Name="PageSubtitle" Text=""
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="32,20">
            <VerticalStackLayout Spacing="16" HorizontalOptions="Center" WidthRequest="700">

                <!-- Current Supplier -->
                <Border Style="{StaticResource CardFrame}" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Current Supplier" TextColor="{StaticResource TextMuted}" FontSize="12" />
                        <HorizontalStackLayout Spacing="12">
                            <Label x:Name="CurrentIcon" FontSize="28" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="CurrentName" TextColor="{StaticResource TextPrimary}"
                                       FontSize="18" FontAttributes="Bold" />
                                <Label x:Name="CurrentTariff" TextColor="{StaticResource Primary}" FontSize="13" />
                                <Label x:Name="CurrentDetail" TextColor="{StaticResource TextMuted}" FontSize="12" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="16">
                            <Label x:Name="CurrentCost" TextColor="{StaticResource Warning}"
                                   FontSize="20" FontAttributes="Bold" />
                            <Label x:Name="CurrentRef" TextColor="{StaticResource TextMuted}"
                                   FontSize="12" VerticalOptions="End" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Available Alternatives -->
                <Label Text="Available Alternatives" TextColor="{StaticResource TextPrimary}"
                       FontSize="16" FontAttributes="Bold" Margin="0,8,0,0" />

                <VerticalStackLayout x:Name="AlternativesList" Spacing="10" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
