<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.FinanceInstitutionProviders"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Grid.Row="0" Padding="0,8,0,16">
            <Label x:Name="ProviderTitle"
                   Text="Institution Providers"
                   Style="{StaticResource Heading2}"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center" />
            <Button x:Name="AddButton"
                    Grid.Column="1"
                    Text="Add"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Clicked="OnAddClicked" />
            <Button x:Name="PrintButton"
                    Grid.Column="2"
                    Text="Print"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Clicked="OnPrintClicked" />
            <Button Grid.Column="3"
                    Text="Close"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnCloseClicked" />
        </Grid>

        <!-- Card -->
        <Border Grid.Row="1"
                Style="{StaticResource CardFrame}"
                BackgroundColor="{StaticResource CardBg}"
                Stroke="{StaticResource BorderColor}"
                StrokeShape="RoundRectangle 12"
                Padding="12">
            <CollectionView ItemsSource="{Binding Providers}">
                <CollectionView.EmptyView>
                    <Label Text="No providers found."
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource CardBgLight}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding ProviderName}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding ProviderType}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding Status}"
                                       TextColor="{StaticResource Accent}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

    </Grid>
</ContentPage>
