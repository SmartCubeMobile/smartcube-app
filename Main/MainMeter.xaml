<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SmartCubeMobile.MainMeter"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Shell.NavBarIsVisible="False"
    Padding="0">

    <ContentPage.Resources>
        <!-- ========================= -->
        <!-- VALUES -->
        <!-- ========================= -->
        <x:Double x:Key="theBorderTwice">2.0</x:Double>
        <x:Double x:Key="theBorderHalf">0.5</x:Double>
        <!-- ========================= -->
        <!-- BUTTON STYLES -->
        <!-- ========================= -->
        <Style x:Key="EllipseButtonStyle"
               TargetType="Button">
            <Setter Property="CornerRadius"
                    Value="999" />
            <Setter Property="BorderColor"
                    Value="CadetBlue" />
            <Setter Property="BorderWidth"
                    Value="2" />
            <Setter Property="Padding"
                    Value="4,5,4,4" />
            <Setter Property="TextColor"
                    Value="Black" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity"
                                        Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Opacity"
                                        Value="0.6" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="CircularButtonStyle"
               TargetType="Button">
            <Setter Property="CornerRadius"
                    Value="999" />
            <Setter Property="BorderWidth"
                    Value="{StaticResource theBorderHalf}" />
            <Setter Property="BorderColor"
                    Value="Black" />
            <Setter Property="Padding"
                    Value="4,5,4,4" />
            <Setter Property="TextColor"
                    Value="Black" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity"
                                        Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Opacity"
                                        Value="0.6" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- ========================= -->
        <!-- LABEL STYLES -->
        <!-- ========================= -->

        <Style x:Key="LabelStyleArial9"
               TargetType="Label">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="HorizontalOptions"
                    Value="Fill" />
            <Setter Property="HorizontalTextAlignment"
                    Value="Center" />
            <Setter Property="VerticalTextAlignment"
                    Value="Center" />
            <Setter Property="FontSize"
                    Value="10" />
            <Setter Property="FontFamily"
                    Value="Arial" />
        </Style>

        <Style x:Key="LabelStyleLedLabel"
               TargetType="Label">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="HorizontalOptions"
                    Value="Center" />
            <Setter Property="VerticalOptions"
                    Value="Start" />
            <Setter Property="FontFamily"
                    Value="Arial" />
            <Setter Property="FontSize"
                    Value="10" />
        </Style>

        <Style x:Key="LabelStyleLed"
               TargetType="Label">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="HorizontalOptions"
                    Value="Center" />
            <Setter Property="VerticalOptions"
                    Value="End" />
            <Setter Property="FontFamily"
                    Value="Webdings" />
            <Setter Property="Text"
                    Value="n" />
            <Setter Property="FontSize"
                    Value="10" />
        </Style>

        <Style x:Key="LabelStyleArial7"
               TargetType="Label">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="HorizontalOptions"
                    Value="Fill" />
            <Setter Property="HorizontalTextAlignment"
                    Value="Center" />
            <Setter Property="VerticalTextAlignment"
                    Value="Center" />
            <Setter Property="FontSize"
                    Value="10" />
            <Setter Property="FontFamily"
                    Value="Arial" />
        </Style>

    </ContentPage.Resources>

    <!-- ====================================================== -->
    <!-- CONTENT -->
    <!-- ====================================================== -->

    <!--<Grid x:Name="DontDeleteMe"
          Margin="0,0,2,15"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">-->
