<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/topPanel"
        android:rowCount="6"
        android:columnCount="8"
        android:orientation="vertical">
        <!-- Start of Meter top -->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnSpan="4"
            android:layout_columnWeight="1"
            android:rowCount="3"
            android:columnCount="2"
            android:orientation="vertical">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:background="@android:color/holo_green_light"
                android:text="@string/totalkWh"
                android:textColor="@android:color/black"
                android:textSize="20sp" />
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:background="@android:color/holo_green_light"
                android:text="@string/totalBills"
                android:textColor="@android:color/black"
                android:textSize="20sp" />
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:background="@android:color/holo_green_light"
                android:text="@string/projected"
                android:textColor="@android:color/black"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/TotalkWh"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:background="@android:color/holo_green_light"
                android:textAlignment="textEnd"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/TotalBilled"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:background="@android:color/holo_green_light"
                android:textAlignment="textEnd"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/Projected"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="1"
                android:background="@android:color/holo_green_light"
                android:textAlignment="textEnd"
                android:textSize="20sp" />
        </GridLayout>
        <Button
            android:layout_width="65dp"
            android:layout_height="20dp"
            android:layout_row="1"
            android:layout_column="0"
            android:background="@android:color/holo_green_light"
            android:id="@+id/Submit"
            android:text="@string/submit" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="0"
            android:text="@string/supplier"
            android:layout_gravity="end"
            android:textSize="20sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="3"
            android:layout_column="0"
            android:text="@string/tariff"
            android:layout_gravity="end"
            android:textSize="20sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="4"
            android:layout_column="0"
            android:text="@string/payment"
            android:textAlignment="textEnd"
            android:textSize="20sp" />
        <TextView
            android:layout_width="75dp"
            android:layout_height="20dp"
            android:layout_row="1"
            android:layout_column="1"
            android:id="@+id/NextConnectionMessage"
            android:layout_gravity="center"
            android:background="@android:color/white"
            android:textSize="20sp" />
        <Spinner
            android:id="@+id/Suppliers"
            android:layout_width="120dp"
            android:layout_height="20dp"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_columnSpan="2"/>
        <Spinner
            android:id="@+id/Tariffs"
            android:layout_width="120dp"
            android:layout_height="20dp"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_columnSpan="2"/>
        <Spinner
            android:id="@+id/PaymentPlans"
            android:layout_width="120dp"
            android:layout_height="20dp"
            android:layout_row="4"
            android:layout_column="1"
            android:layout_columnSpan="2"/>
        <Button
            android:id="@+id/Cancel"
            android:layout_width="65dp"
            android:layout_height="20dp"
            android:layout_row="1"
            android:layout_column="3"
            android:layout_gravity="start"
            android:background="@android:color/holo_red_light"
            android:text="@string/cancel" />
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="3"
            android:columnCount="2"
            android:orientation="vertical">
            <TextView
                android:id="@+id/LedSwitched"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_row="0"
                android:layout_column="0"
                android:text="@string/switched"
                android:textAlignment="center"
                android:textColor="@android:color/holo_orange_light"
                android:textSize="12sp" />
        </GridLayout>
        <TextView
            android:layout_width="80dp"
            android:layout_height="20dp"
            android:layout_row="3"
            android:layout_column="3"
            android:id="@+id/AreaIdDynamic"
            android:text="@string/area"
            android:textAlignment="center"
            android:textSize="20sp" />
        <TextView
            android:layout_width="80dp"
            android:layout_height="20dp"
            android:layout_row="4"
            android:layout_column="3"
            android:id="@+id/AccountNoDynamic"
            android:text="@string/account"
            android:textAlignment="textEnd"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/Economy7"
            android:layout_width="80dp"
            android:layout_height="20dp"
            android:layout_row="5"
            android:layout_column="3"
            android:background="@android:color/white"
            android:text="@string/economy7"
            android:textAlignment="center"
            android:textSize="12sp"
            android:textStyle="italic" />
        <CheckBox
            android:id="@+id/checkBox60"
            android:layout_width="80dp"
            android:layout_height="25dp"
            android:layout_row="5"
            android:layout_column="3"
            android:text="@string/age60plus"
            android:textAlignment="textStart"
            android:textSize="12sp" />
        <!-- <CheckBox
            android:id="@+id/checkBoxSmooth"
            android:layout_width="80dp"
            android:layout_height="25dp"
            android:layout_row="6"
            android:layout_column="3"
            android:text="Smooth"
            android:textAlignment="textStart"
            android:textSize="10dp" />     -->
        <!--Start of Column 3-->
        <GridLayout
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="4"
            android:layout_columnWeight="0"
            android:rowCount="3"
            android:columnCount="2"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/RBElectricity"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_row="0"
                android:layout_column="0"
                android:tag="E"/>
            <ImageView
                android:contentDescription="@string/electricbulbsymbol"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_row="0"
                android:layout_column="1"
                android:src="@drawable/ElectricLightBulb"/>
            <RadioButton
                android:id="@+id/RBGas"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_row="1"
                android:layout_column="0"
                android:tag="G"/>
            <ImageView
                android:contentDescription="@string/gasflamesymbol"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_row="1"
                android:layout_column="1"
                android:src="@drawable/GasFlame" />
            <RadioButton
                android:id="@+id/RBDualFuel"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_row="2"
                android:layout_column="0"
                android:tag="D"/>
            <ImageView
                android:contentDescription="@string/dualfuelsymbol"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_row="2"
                android:layout_column="1"
                android:src="@drawable/ElectricLightBulb" />
        </GridLayout>

        <!-- Start of Column 4 -->
        <GridLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="5"
            android:layout_columnSpan="2"
            android:rowCount="2"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:text="@string/address"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:textSize="20sp" />
            <Spinner
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:id="@+id/Addresses"
                android:textAlignment="center"
                android:layout_gravity="center" />
        </GridLayout>
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="5"
            android:layout_rowSpan="5"
            android:layout_columnSpan="2"
            android:rowCount="6"
            android:columnCount="4"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnSpan="2"
                android:text="@string/dayrate"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_row="0"
                android:layout_column="2"
                android:text="@string/nightrate"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_row="0"
                android:layout_column="3"
                android:text="@string/standingcharge"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:textSize="15sp" />
            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnSpan="4"
                android:rowCount="2"
                android:columnCount="3"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/DayRate1"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_gravity="center"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/NightRate1"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/StandingCharge1"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_gravity="center"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/DayRate2"
                    android:layout_width="75dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_gravity="center"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/NightRate2"
                    android:layout_width="75dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/StandingCharge2"
                    android:layout_width="75dp"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_gravity="center"
                    android:textSize="15sp" />
            </GridLayout>

            <GridLayout
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_row="4"
                android:layout_column="0"
                android:layout_rowSpan="2"
                android:layout_columnSpan="4"
                android:rowCount="5"
                android:columnCount="3"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:text="@string/startdate"
                    android:layout_gravity="center"
                    android:textSize="20sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:text="@string/enddate"
                    android:layout_gravity="center"
                    android:textSize="20sp" />
                <DatePicker
                    android:id="@+id/StartingDate"
                    android:layout_width="50dp"
                    android:layout_height="15dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_gravity="center" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:id="@+id/ResetDates"
                    android:layout_gravity="center"
                    android:background="@android:color/holo_blue_bright"
                    android:text="@string/reset" />
                <DatePicker
                    android:id="@+id/EndingDate"
                    android:layout_width="50dp"
                    android:layout_height="15dp"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_gravity="center" />
                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="2"
                    android:layout_column="0"
                    android:layout_rowSpan="3"
                    android:layout_columnSpan="3"
                    android:rowCount="4"
                    android:columnCount="2"
                    android:orientation="vertical">
                    <TextView
                        android:layout_row="0"
                        android:layout_column="0"
                        android:text="@string/totalcost"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="20sp" />
                    <TextView
                        android:layout_row="0"
                        android:layout_column="1"
                        android:text="@string/totalreadings"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="20sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_row="1"
                        android:layout_column="0"
                        android:id="@+id/TotalCost"
                        android:layout_gravity="end"
                        android:textSize="20sp"
                        android:background="@android:color/white"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_row="1"
                        android:layout_column="1"
                        android:id="@+id/TotalReadings"
                        android:layout_gravity="end"
                        android:textSize="20sp"
                        android:background="@android:color/white"/>
                </GridLayout>
            </GridLayout>
        </GridLayout>

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="7"
            android:layout_rowSpan="6"
            android:rowCount="11"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/pictureBoxDNO"
                android:contentDescription="@string/supplyarea"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_gravity="top"
                android:adjustViewBounds="true"
                android:maxHeight="30dp"
                android:minHeight="30dp"
                android:scaleType="fitCenter" />
            <!-- This above was the source of al my pain ....-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:text="@string/postcode"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/Postcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_gravity="center"
                android:textSize="20sp"
                android:background="@android:color/white"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="3"
                android:layout_column="0"
                android:layout_gravity="center"
                android:background="#ffff00"
                android:text="@string/displaycultures"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/utilityCultures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="4"
                android:layout_column="0"
                android:background="@android:color/white"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_row="5"
                android:layout_column="0"
                android:layout_gravity="center"
                android:background="#ffff00"
                android:text="@string/conversionrates"
                android:textSize="15sp" />
            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_row="6"
                android:layout_column="0"
                android:layout_rowSpan="2">
                <RadioButton
                    android:id="@+id/RBGBP"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textSize="12sp"
                    android:tag="@string/GBP"
                    android:text="@string/GBP"
                    android:background="@android:color/white"/>
                <RadioButton
                    android:id="@+id/RBEUR"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textSize="12sp"
                    android:tag="@string/EUR"
                    android:text="@string/EUR"
                    android:background="@android:color/white"/>
                <RadioButton
                    android:id="@+id/RBUSD"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textSize="12sp"
                    android:tag="@string/USD"
                    android:text="@string/USD"
                    android:background="@android:color/white"/>
                <RadioButton
                    android:id="@+id/RBJPY"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textSize="12sp"
                    android:tag="@string/JPY"
                    android:text="@string/JPY"
                    android:background="@android:color/white"/>
                </RadioGroup>
        </GridLayout>
    </GridLayout>
    <!-- End Utility Top -->

    <!-- Start of Column 5 -->


    <!-- Start of Utility Bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.google.android.material.tabs.TabLayout
            app:tabBackground="@android:color/holo_green_light"
            app:tabMode="fixed"
            app:tabIndicatorAnimationMode="linear"
            app:tabIndicatorColor="#EF0C4C"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="2dp"
            app:tabSelectedTextColor="#EF0C4C"
            app:tabGravity="fill"
            android:id="@+id/utilitytabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabTextAppearance="@style/TabTextAppearance"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/utilityviewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <!-- End of Utility Bottom -->
</LinearLayout>