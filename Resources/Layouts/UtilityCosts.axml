<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">
    
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Supplier Name"
            android:id="@+id/headerSupplierName"
            android:layout_width = "250dp"
            android:layout_weight = "2"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Tariff Name"
            android:id="@+id/headerTariffName"
            android:layout_width = "250dp"
            android:layout_weight = "2"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Meter Type"
            android:id="@+id/headerMeterType"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Payment Name"
            android:id="@+id/headerPaymentName"
            android:layout_width = "200dp"
            android:layout_weight = "1"
            android:gravity = "left"
            android:textSize = "15sp"
            android:layout_height = "25dp"/>
     <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/black"
            android:text="Total Amount"
            android:id="@+id/headerTotalAmount"
            android:layout_width = "80dp"
            android:layout_weight = "1"
            android:gravity = "right"
            android:textSize = "15sp"
            android:layout_height = "25dp"/> 
      </LinearLayout>
      
    <FrameLayout
        android:background="@android:color/holo_blue_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.recyclerview.widget.RecyclerView 
            android:background="@android:color/white"        
            android:id="@+id/utilityCosts"      
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</LinearLayout>