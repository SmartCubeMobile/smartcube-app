<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.SwitchDetails"
             Title="Switch Details"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <Grid Padding="20">
            <Border Style="{StaticResource CardFrame}"
                    BackgroundColor="{StaticResource CardBg}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Padding="16" Spacing="14">
                    <Label Text="Switch Details"
                           Style="{StaticResource Heading2}"
                           TextColor="{StaticResource TextPrimary}" />

                    <BoxView HeightRequest="1"
                             Color="{StaticResource BorderColor}" />

                    <Label x:Name="SwitchStatusMessage"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="14" />

                    <Label x:Name="SwitchStatusMessage2"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="14" />

                    <BoxView HeightRequest="1"
                             Color="{StaticResource BorderColor}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Account Name"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12" />
                        <Entry x:Name="AccountName"
                               Placeholder="Enter account name"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextMuted}"
                               BackgroundColor="{StaticResource CardBgLight}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sort Code"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12" />
                        <Entry x:Name="AccountSortCode"
                               Placeholder="Enter sort code"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextMuted}"
                               BackgroundColor="{StaticResource CardBgLight}"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Account Number"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12" />
                        <Entry x:Name="AccountNumber"
                               Placeholder="Enter account number"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextMuted}"
                               BackgroundColor="{StaticResource CardBgLight}"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <Label x:Name="SwitchStatusMessage5"
                           TextColor="{StaticResource Accent}"
                           FontSize="13" />

                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="End"
                                           Margin="0,8,0,0">
                        <Button Text="Cancel"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Text="Submit"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>

</ContentPage>
