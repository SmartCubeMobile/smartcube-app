<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.UtilityBillsPopup"
             Title="Utility Bills"
             BackgroundColor="{StaticResource PageBg}">

    <Grid Padding="20">
        <Border Style="{StaticResource CardFrame}"
                BackgroundColor="{StaticResource CardBg}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Utility Bills"
                       Style="{StaticResource Heading2}"
                       TextColor="{StaticResource TextPrimary}" />

                <BoxView HeightRequest="1"
                         Color="{StaticResource BorderColor}" />

                <CollectionView>
                    <CollectionView.EmptyView>
                        <Label Text="No bills available"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center"
                               Margin="0,20,0,0" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
