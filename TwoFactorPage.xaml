<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.TwoFactorPage"
             BackgroundColor="#0A0F1E"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Border x:Name="Card"
                BackgroundColor="#131B2E"
                Stroke="#1E2D4A"
                StrokeThickness="1"
                Padding="36,32"
                WidthRequest="480"
                Margin="0,30"
                VerticalOptions="Center" HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="0">
                <Label Text="Two-Factor Authentication" FontSize="22" FontAttributes="Bold"
                       TextColor="#F1F5F9" HorizontalOptions="Center" />
                <Label x:Name="IntroLabel" Text=""
                       FontSize="13" TextColor="#64748B" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Margin="0,6,0,20" />

                <!-- Step 1: scan -->
                <VerticalStackLayout x:Name="SetupSection" IsVisible="False" Spacing="0">
                    <Label Text="1. Install an authenticator app on your phone (Google Authenticator, Microsoft Authenticator, Authy or similar)."
                           FontSize="12" TextColor="#CBD5E1" LineBreakMode="WordWrap" />
                    <Label Text="2. Scan this code with the app:" FontSize="12" TextColor="#CBD5E1" Margin="0,10,0,8" />
                    <Border BackgroundColor="White" Padding="8" HorizontalOptions="Center" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Image x:Name="QrImage" WidthRequest="200" HeightRequest="200" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Can't scan? Enter this key by hand:" FontSize="11" TextColor="#64748B" Margin="0,10,0,4" HorizontalOptions="Center" />
                    <Label x:Name="KeyLabel" Text="" FontSize="13" FontFamily="Consolas" TextColor="#F1F5F9"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

                    <Label Text="3. Enter the 6-digit code the app shows:" FontSize="12" TextColor="#CBD5E1" Margin="0,18,0,6" />
                    <Border BackgroundColor="#0A0F1E" Stroke="#1E2D4A" StrokeThickness="1" Padding="12,0" HeightRequest="44">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Entry x:Name="SetupCodeEntry" Placeholder="123 456" Keyboard="Numeric" MaxLength="7"
                               PlaceholderColor="#475569" TextColor="#F1F5F9" BackgroundColor="Transparent"
                               FontSize="18" CharacterSpacing="4" VerticalOptions="Center" ReturnType="Go"
                               Completed="OnEnableClicked"
                               ToolTipProperties.Text="Enter the 6-digit code your authenticator app shows for SmartCube." />
                    </Border>
                    <Button x:Name="EnableBtn" Text="Turn On Two-Factor" FontSize="15" FontAttributes="Bold"
                            BackgroundColor="#10B981" TextColor="White" CornerRadius="12" HeightRequest="48"
                            Margin="0,16,0,0" Clicked="OnEnableClicked"
                            ToolTipProperties.Text="Turn on two-factor authentication using the code you entered." />
                </VerticalStackLayout>

                <!-- Recovery codes (shown once after enabling) -->
                <VerticalStackLayout x:Name="CodesSection" IsVisible="False" Spacing="0">
                    <Label Text="Two-factor is now on." FontSize="14" FontAttributes="Bold" TextColor="#22C55E" HorizontalOptions="Center" />
                    <Label Text="Save these recovery codes somewhere safe. Each one signs you in once if you lose your phone. They will not be shown again."
                           FontSize="12" TextColor="#CBD5E1" LineBreakMode="WordWrap" Margin="0,8,0,12" HorizontalTextAlignment="Center" />
                    <Border BackgroundColor="#0A0F1E" Stroke="#1E2D4A" StrokeThickness="1" Padding="16,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Label x:Name="CodesLabel" Text="" FontSize="14" FontFamily="Consolas" TextColor="#F1F5F9"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" LineHeight="1.4" />
                    </Border>
                    <Button x:Name="CopyBtn" Text="Copy codes" FontSize="13" FontAttributes="Bold"
                            BackgroundColor="#1E3A5F" TextColor="#60A5FA" CornerRadius="10" HeightRequest="40"
                            Margin="0,12,0,0" Clicked="OnCopyCodesClicked"
                            ToolTipProperties.Text="Copy your recovery codes to the clipboard." />
                </VerticalStackLayout>

                <!-- Manage (already on) -->
                <VerticalStackLayout x:Name="ManageSection" IsVisible="False" Spacing="0">
                    <Label x:Name="ManageStatus" Text="" FontSize="13" TextColor="#22C55E" HorizontalOptions="Center" />
                    <Label Text="To turn two-factor off, enter a current code from your authenticator app or one of your recovery codes."
                           FontSize="12" TextColor="#CBD5E1" LineBreakMode="WordWrap" Margin="0,14,0,6" HorizontalTextAlignment="Center" />
                    <Border BackgroundColor="#0A0F1E" Stroke="#1E2D4A" StrokeThickness="1" Padding="12,0" HeightRequest="44">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Entry x:Name="DisableCodeEntry" Placeholder="Code" PlaceholderColor="#475569" TextColor="#F1F5F9"
                               BackgroundColor="Transparent" FontSize="16" CharacterSpacing="3" VerticalOptions="Center"
                               ToolTipProperties.Text="A current code from your authenticator app, or one of your recovery codes." />
                    </Border>
                    <Button x:Name="DisableBtn" Text="Turn Off Two-Factor" FontSize="14" FontAttributes="Bold"
                            BackgroundColor="#3B1A1A" TextColor="#EF4444" CornerRadius="12" HeightRequest="44"
                            Margin="0,14,0,0" Clicked="OnDisableClicked"
                            ToolTipProperties.Text="Turn off two-factor authentication for your account." />
                </VerticalStackLayout>

                <Button x:Name="CloseBtn" Text="Close" FontSize="13" BackgroundColor="Transparent"
                        TextColor="#94A3B8" HeightRequest="40" Margin="0,8,0,0" Clicked="OnCloseClicked"
                        ToolTipProperties.Text="Close and go back." />

                <Label x:Name="StatusLabel" Text="" FontSize="12" TextColor="#F87171"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" Margin="0,6,0,0" IsVisible="False" />
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
