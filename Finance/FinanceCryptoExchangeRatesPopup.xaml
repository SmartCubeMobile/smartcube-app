<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.FinanceCryptoExchangeRatesPopup"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Grid.Row="0" Padding="0,8,0,16">
            <Label Text="Crypto Exchange Rates"
                   Style="{StaticResource Heading2}"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Close"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnCloseClicked" />
        </Grid>

        <!-- Card -->
        <Border Grid.Row="1"
                Style="{StaticResource CardFrame}"
                BackgroundColor="{StaticResource CardBg}"
                Stroke="{StaticResource BorderColor}"
                StrokeShape="RoundRectangle 12"
                Padding="12">
            <CollectionView ItemsSource="{Binding ExchangeRates}">
                <CollectionView.EmptyView>
                    <Label Text="No exchange rates available."
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource CardBgLight}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding CurrencyPair}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Rate}"
                                       TextColor="{StaticResource Accent}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Print Button -->
        <Button x:Name="PrintButton"
                Grid.Row="2"
                Text="Print"
                Style="{StaticResource SecondaryButton}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource TextPrimary}"
                Margin="0,12,0,0"
                HorizontalOptions="Fill"
                Clicked="OnPrintClicked" />

    </Grid>
</ContentPage>
