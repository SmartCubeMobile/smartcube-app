        </Grid>-->

    <!-- ======================================== -->
    <!-- MAIN BORDER -->
    <!-- ======================================== -->
    <Grid x:Name="DontDeleteMe" 
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <Border Stroke="Gray"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 5"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">

            <Grid x:Name="Container"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="27*" />
                    <ColumnDefinition Width="73*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Source="meter_background.jpg"
                       Aspect="AspectFill" 
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
      
                       ZIndex="-1"
                       InputTransparent="True"/>

                <!-- ================================================= -->
                <!-- LEFT PANEL -->
                <!-- ================================================= -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="6*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                        BackgroundColor="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="6*" />
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0"
                               Source="smartcube_mobile_logo.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
                        <Label x:Name="labelTheManWhoNeverGaveUp"
                               Grid.Row="1"
                               HorizontalOptions="End"
                               FontSize="10"
                               Text="by Ray Chapman"
                               FontFamily="Arial"
                               FontAttributes="Italic"/>

                        <!-- IsVisible="{Binding BorderVisible}"
                              IsVisible="{Binding ScrollViewerVisible}"
                                    -->
                        <Border x:Name="Border"
                            Grid.Row="2"
                            Padding="10"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">
                            <ScrollView x:Name="ScrollViewer"
                                VerticalOptions="Fill"
                                HorizontalOptions="Fill"
                                BackgroundColor="Black">
                                <Label x:Name="LogLabel"
                                   Text="{Binding TextBlockContent}"
                                   TextColor="White"
                                   FontSize="10"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Start"
                                   HorizontalOptions="Fill"/>
                            </ScrollView>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                        Grid.Column="0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        BackgroundColor="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="6*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="6*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="8*"/>
                            <RowDefinition Height="6*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25*"/>
                            <ColumnDefinition Width="40*"/>
                            <ColumnDefinition Width="25*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="OpenCloseButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="{Binding OpenCloseColour}"
                                Style="{StaticResource EllipseButtonStyle}"
                                Text="OPEN/CLOSE"
                                FontSize="Small"
                                Margin="0,3,0,0" />

                        <Label Grid.Row="4"
                               Grid.Column="1"
                               Style="{StaticResource LabelStyleArial9}"
                               Text="Username" />

                        <!--IsVisible="{Binding UserNameVisible}" -->
                        <Label Grid.Row="5"
                               Grid.Column="1"
                               Style="{StaticResource LabelStyleArial9}"
                               Text="{Binding UserName}"
                               TextColor="{Binding UserNameColour}"                                   
                               BackgroundColor="White"/>

                        <!--<Picker Grid.Row="5"
                                Grid.Column="1"
                                IsVisible="{Binding UserNameListVisible}"
                                ItemsSource="{Binding UserNamesList}" />-->

                        <Label Grid.Row="6"
                               Grid.Column="1"
                               Text="Date/Time"
                               Style="{StaticResource LabelStyleArial9}" />

                        <Label x:Name="MeterTimeText"
                            Grid.Row="7"
                            Grid.Column="1"
                            BackgroundColor="White"
                            Text="{Binding DateTimeNowMessage}"
                            TextColor="Black"
                            Style="{StaticResource LabelStyleArial9}" />

                        <Grid Grid.Row="9" Grid.Column="1"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" VerticalOptions="Center" Style="{StaticResource LabelStyleLedLabel}" Text="TR" />
                            <Label Grid.Row="1" Grid.Column="0" VerticalOptions="Center" TextColor="{Binding Led1}" Style="{StaticResource LabelStyleLed}"/>
                            <Label Grid.Row="0" Grid.Column="1" VerticalOptions="Center" Style="{StaticResource LabelStyleLedLabel}" Text="DBS"/>
                            <Label Grid.Row="1" Grid.Column="1" VerticalOptions="Center" TextColor="{Binding Led2}" Style="{StaticResource LabelStyleLed}"/>
                            <Label Grid.Row="0" Grid.Column="2" VerticalOptions="Center" Style="{StaticResource LabelStyleLedLabel}" Text="UD"/>
                            <Label Grid.Row="1" Grid.Column="2" VerticalOptions="Center" TextColor="{Binding Led3}" Style="{StaticResource LabelStyleLed}"/>
                            <Label Grid.Row="0" Grid.Column="3" VerticalOptions="Center" Style="{StaticResource LabelStyleLedLabel}" Text="TD"/>
                            <Label Grid.Row="1" Grid.Column="3" VerticalOptions="Center" TextColor="{Binding Led4}" Style="{StaticResource LabelStyleLed}"/>
                            <Label Grid.Row="2" Grid.Column="0" VerticalOptions="Center" Style="{StaticResource LabelStyleLedLabel}" Text="NW"/>
                            <Label Grid.Row="3" Grid.Column="0" VerticalOptions="Center" TextColor="{Binding Led5}" Style="{StaticResource LabelStyleLed}"/>
                            <Label Grid.Row="2" Grid.Column="1" VerticalOptions="Center" Style="{StaticResource LabelStyleLedLabel}" Text="MR"/>
                            <Label Grid.Row="3" Grid.Column="1" VerticalOptions="Center" TextColor="{Binding Led6}" Style="{StaticResource LabelStyleLed}"/>
                            <Label Grid.Row="2" Grid.Column="2" VerticalOptions="Center" Style="{StaticResource LabelStyleLedLabel}" Text="SW"/>
                            <Label Grid.Row="3" Grid.Column="2" VerticalOptions="Center" TextColor="{Binding Led7}" Style="{StaticResource LabelStyleLed}"/>
                            <Label Grid.Row="2" Grid.Column="3" VerticalOptions="Center" Style="{StaticResource LabelStyleLedLabel}" Text="FAIL"/>
                            <Label Grid.Row="3" Grid.Column="3" VerticalOptions="Center" TextColor="{Binding Led8}" Style="{StaticResource LabelStyleLed}"/>
                        </Grid>

                        <Button x:Name="ButtonQuit"
                                Grid.Row="10"
                                Grid.Column="0"
                                Style="{StaticResource EllipseButtonStyle}"
                                BackgroundColor="{Binding QuitColour}"
                                Text="QUIT"
                                FontSize="Small"
                                Margin="4,0,0,0" />
                    </Grid>
                </Grid>

                <!-- ================================================= -->
                <!-- RIGHT PANEL -->
                <!-- ================================================= -->

                <Grid Grid.Column="1"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" />
                        <RowDefinition Height="95*" />
                    </Grid.RowDefinitions>

                    <!-- ================================================= -->
                    <!-- FULLSCREEN BUTTON -->
                    <!-- ================================================= -->

                    <Button x:Name="FullScreen"
                        Grid.Row="0"
                        Margin="0,1,1,0"
                        Style="{StaticResource CircularButtonStyle}"
                        BackgroundColor="Orange"
                        Text="+"
                        FontSize="Micro"
                        VerticalOptions="Start"
                        HorizontalOptions="End"
                        MinimumWidthRequest="18"
                        MinimumHeightRequest="18" />

                    <!-- ================================================= -->
                    <!-- MAIN CONTENT AREA -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="1"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*" />
                            <RowDefinition Height="6*" />
                        </Grid.RowDefinitions>

                        <!-- ================================================= -->
                        <!-- CAROUSEL -->
                        <!-- ================================================= -->

                        <Border x:Name="MyCarousel"
                            Grid.RowSpan="2"
                            Stroke="Silver"
                            StrokeThickness="1"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            BackgroundColor="Transparent">

                            <Grid HorizontalOptions="Fill"
                                  VerticalOptions="Fill">

                                <!-- ================================================= -->
                                <!-- USER CONTENT -->
                                <!-- ================================================= -->

                                <ContentView x:Name="UserControl"
                                     Content="{Binding MyContent}"
                                     IsEnabled="{Binding CarouselEnabled}"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill"
                                     BackgroundColor="Transparent"/>

                                <!-- TOP HANDLE -->
                                <Border
                                    Stroke="Gray"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    WidthRequest="25"
                                    HeightRequest="15"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Start"
                                    TranslationY="-6"
                                    ZIndex="10">

                                    <Label Text="▲"
                                       FontSize="8"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                                </Border>

                                <!-- BOTTOM HANDLE -->
                                <Border
                                    Stroke="Gray"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    WidthRequest="25"
                                    HeightRequest="15"
                                    HorizontalOptions="Center"
                                    VerticalOptions="End"
                                    TranslationY="6"
                                    ZIndex="10">

                                    <Label Text="▼"
                                       FontSize="8"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                                </Border>

                                <!-- LEFT HANDLE -->
                                <Border x:Name="ButtonLeft"
                                           
                                    Stroke="Gray"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    WidthRequest="15"
                                    HeightRequest="25"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    TranslationX="-6"
                                    ZIndex="10">

                                    <Label Text="◀"
                                       FontSize="8"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       />
                                </Border>

                                <!-- RIGHT HANDLE -->
                                <Border x:Name="ButtonRight"
                                           
                                    Stroke="Gray"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    WidthRequest="15"
                                    HeightRequest="25"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    TranslationX="6"
                                    ZIndex="10">

                                    <Label Text="▶"
                                       FontSize="8"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center">
                                        
                                    </Label>
                                </Border>

                            </Grid>

                        </Border>

                        <!-- ================================================= -->
                        <!-- METER TOP -->
                        <!-- ================================================= -->

                        <Image x:Name="MeterTop"
                           Grid.Row="0"
                           Source="meter_top.jpg"
                           Aspect="AspectFill"
                           AnchorX="0.5"
                           AnchorY="0"
                           IsVisible="True"/>

                        <!-- ================================================= -->
                        <!-- METER BOTTOM -->
                        <!-- ================================================= -->

                        <Image x:Name="MeterBottom"
                           Grid.Row="1"
                           Source="meter_bottom.jpg"
                           Aspect="AspectFill"
                           AnchorX="0.5"
                           AnchorY="1"
                           IsVisible="True"/>

                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>