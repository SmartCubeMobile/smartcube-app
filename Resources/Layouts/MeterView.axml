<?xml version="1.0" encoding="utf-8"?>
<GridLayout
   xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:rowCount="1"
    android:columnCount="2"
    android:id="@+id/meterview"
    android:background="@drawable/MeterBackground"    
    android:orientation="vertical">
    
    <LinearLayout
            android:contentDescription="@string/leftframe"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_row="0"
            android:layout_column="0"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
        <ImageView
                android:layout_width="250dp"
                android:layout_height="100dp"
                android:layout_gravity="top"
                android:adjustViewBounds="true"
                android:contentDescription="@string/smartswitchlogo"
                android:scaleType="fitXY"
                android:src="@drawable/SmartSwitchLogo" />

            <TextView
                android:id="@+id/TheManWhoNeverGaveUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="15dp"
                android:text="@string/themanwhonevergaveup"
                android:textColor="@android:color/black"
                android:textSize="11sp"
                android:textStyle="italic" />

            <ScrollView
                android:id="@+id/ScrollViewer"
                android:layout_width="250dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:background="@android:color/black"
                android:fillViewport="true"
                android:visibility="visible">

                <TextView
                    android:id="@+id/TextBlockBrowser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </ScrollView>

            <Button
                android:id="@+id/AutoSwitch"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/elliptical_button"
                android:text="@string/autoswitch"
                android:textColor="@android:color/black"/>
            <Button
                android:id="@+id/OpenClose"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/elliptical_button"
                android:text="@string/openclose"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/Username"
                android:layout_width="150dp"
                android:layout_height="25dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@android:color/white"
                android:gravity="center"
                android:text="@string/username"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/DateTimeNow"
                android:layout_width="150dp"
                android:layout_height="25dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@android:color/white"
                android:gravity="center"
                android:text="@string/datetime"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:textSize="15sp" />

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:columnCount="4"
                android:rowCount="4">

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="28dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:text="@string/tr"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="28dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:text="@string/dbs"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="28dp"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:text="@string/ud"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="28dp"
                    android:layout_row="0"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:text="@string/td"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/Led1"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:text="@string/led"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/Led2"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:text="@string/led"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/Led3"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:text="@string/led"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/Led4"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:layout_row="1"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:text="@string/led"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="28dp"
                    android:layout_row="2"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:text="@string/nw"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="28dp"
                    android:layout_row="2"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:text="@string/mr"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="28dp"
                    android:layout_row="2"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:text="@string/sw"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="28dp"
                    android:layout_row="2"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:text="@string/fail"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/Led5"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:layout_row="3"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:text="@string/led"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/Led6"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:layout_row="3"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:text="@string/led"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/Led7"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:layout_row="3"
                    android:layout_column="2"
                    android:layout_columnWeight="1"
                    android:text="@string/led"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/Led8"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:layout_row="3"
                    android:layout_column="3"
                    android:layout_columnWeight="1"
                    android:text="@string/led"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="15sp" />
            </GridLayout>

            <Button
                android:id="@+id/Quit"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/round_button"
                    
                android:textAlignment="center"
                android:textSize="18sp"
                android:textColor = "@android:color/black">
            </Button>
    </LinearLayout>        
    <!-- End of Left Panel -->

    <!-- Start of Right Panel -->
    <GridLayout
        android:layout_marginLeft="30dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_column="1"
        android:rowCount="3"
        android:columnCount="1">

        <TextView
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_row="0"
                    android:background="@android:color/transparent"
                    android:gravity="end"
                    android:textSize="30sp"
                    android:textColor="@android:color/holo_orange_light"
                    android:text="@string/fullscreen"
                    android:textStyle="bold"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_marginBottom="45dp"
            android:layout_height="match_parent"
            android:layout_row="1"
            android:layout_column="0" 
            android:layout_rowSpan="2"
            android:visibility="visible"
            android:id="@+id/MyContent"                    
            android:contentDescription="Right Frame"
            android:background="@android:color/holo_green_light">
            <TextView 
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Right Frame"
                android:textSize="50dp">
            </TextView>
        </FrameLayout>

        <ImageView
            android:layout_row="1"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/MeterTop"
            android:visibility="visible"
            android:scaleType="fitXY"     
            android:id="@+id/MeterTop">
        </ImageView>
        <ImageView
             android:layout_row="2"
             android:layout_column="0" 
             android:layout_rowWeight="1"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:src="@drawable/MeterBottom"
             android:visibility="visible"
             android:scaleType="fitXY"
             android:id="@+id/MeterBottom">
        </ImageView>
    </GridLayout>
</GridLayout>