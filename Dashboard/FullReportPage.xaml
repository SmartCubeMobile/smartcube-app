<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.Dashboard.FullReportPage"
             BackgroundColor="{StaticResource PageBg}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource NavBg}"
                Stroke="{StaticResource BorderColor}" StrokeThickness="0,0,0,1"
                Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="BackButton" Text="←" BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}" FontSize="20"
                        Padding="0" WidthRequest="40" HeightRequest="40"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="SmartCube Report" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label x:Name="ReportDate" FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                <Image Grid.Column="2" Source="smartcube_mobile_logo.png"
                       WidthRequest="36" HeightRequest="36" Aspect="AspectFit"
                       VerticalOptions="Center" Margin="0,0,8,0" />
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="24,16">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="950" HorizontalOptions="Center">

                <!-- Net Worth Overview -->
                <Border x:Name="NetWorthCard" Style="{StaticResource CardFrame}" Padding="24">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Net Worth Overview" Style="{StaticResource Heading2}" />
                        <Grid x:Name="NetWorthGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="16" />
                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                        <Grid x:Name="NetWorthBreakdown" ColumnDefinitions="*,*,*,*" ColumnSpacing="16" />
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ BANKING ═══ -->
                <Label Text="Banking" TextColor="{StaticResource Primary}" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border x:Name="BankSummaryCard" Style="{StaticResource CardFrame}" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Account Summary" Style="{StaticResource Heading2}" />
                            <VerticalStackLayout x:Name="BankAccountsList" Spacing="6" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="SpendingCard" Style="{StaticResource CardFrame}" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Spending by Category" Style="{StaticResource Heading2}" />
                            <VerticalStackLayout x:Name="SpendingList" Spacing="6" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ═══ UTILITY ═══ -->
                <Label Text="Utility" TextColor="{StaticResource Primary}" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border x:Name="UtilitySummaryCard" Style="{StaticResource CardFrame}" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Monthly Costs" Style="{StaticResource Heading2}" />
                            <VerticalStackLayout x:Name="UtilityMonthlyCosts" Spacing="6" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="UtilitySupplierCard" Style="{StaticResource CardFrame}" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Supplier Breakdown" Style="{StaticResource Heading2}" />
                            <VerticalStackLayout x:Name="UtilitySupplierList" Spacing="6" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ═══ CRYPTO ═══ -->
                <Label Text="Crypto" TextColor="{StaticResource Primary}" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border x:Name="CryptoSummaryCard" Style="{StaticResource CardFrame}" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Portfolio Holdings" Style="{StaticResource Heading2}" />
                            <VerticalStackLayout x:Name="CryptoHoldingsList" Spacing="6" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="CryptoKpiCard" Style="{StaticResource CardFrame}" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Crypto Summary" Style="{StaticResource Heading2}" />
                            <Grid x:Name="CryptoKpiGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="14" ColumnSpacing="16" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ═══ INVESTMENTS ═══ -->
                <Label Text="Investments" TextColor="{StaticResource Primary}" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

                <Border x:Name="InvKpiCard" Style="{StaticResource CardFrame}" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Portfolio Performance" Style="{StaticResource Heading2}" />
                        <Grid x:Name="InvKpiGrid" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border x:Name="InvHoldingsCard" Style="{StaticResource CardFrame}" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Holdings" Style="{StaticResource Heading2}" />
                            <VerticalStackLayout x:Name="InvHoldingsList" Spacing="4" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="16">
                        <Border x:Name="InvSectorCard" Style="{StaticResource CardFrame}" Padding="20">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Sector Allocation" Style="{StaticResource Heading2}" />
                                <VerticalStackLayout x:Name="InvSectorList" Spacing="6" />
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="InvDividendCard" Style="{StaticResource CardFrame}" Padding="20">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Dividend Income (Est.)" Style="{StaticResource Heading2}" />
                                <VerticalStackLayout x:Name="InvDividendList" Spacing="6" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
