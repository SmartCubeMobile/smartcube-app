<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.Dashboard.Faces.InvestmentsFace"
             BackgroundColor="{StaticResource PageBg}">

    <Grid ColumnDefinitions="*,320" Padding="16" ColumnSpacing="12">

        <!-- Left: Holdings list -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">

            <!-- KPI row -->
            <ScrollView Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <HorizontalStackLayout x:Name="KpiCards" Spacing="12" />
            </ScrollView>

            <!-- Holdings table -->
            <Border Grid.Row="1" x:Name="HoldingsCard" Style="{StaticResource CardFrame}" Padding="16">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,12">
                        <Label Text="Holdings" Style="{StaticResource Heading2}" />
                        <Label Grid.Column="1" x:Name="HoldingsCount"
                               Style="{StaticResource SubHeading}" VerticalOptions="Center" />
                        <Button Grid.Column="2" x:Name="AddInvestmentBtn"
                                Text="+ Add"
                                FontSize="12" Padding="12,6"
                                CornerRadius="8" HeightRequest="32"
                                BackgroundColor="{StaticResource CardBgLight}"
                                TextColor="{StaticResource Accent}"
                                BorderColor="{StaticResource GlowBorder}"
                                BorderWidth="1"
                                VerticalOptions="Center"
                                Clicked="OnAddInvestmentClicked" />
                    </Grid>
                    <CollectionView Grid.Row="1" x:Name="HoldingsList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource CardBgLight}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="Transparent"
                                        Padding="14,10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="60,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Symbol}"
                                               TextColor="{StaticResource Accent}"
                                               FontSize="13" FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding TypeBadge}"
                                               TextColor="{Binding TypeColour}"
                                               FontSize="9" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Name}"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="12" VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                        <VerticalStackLayout Grid.Column="3" Spacing="1"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding ValueFormatted}"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding SharesFormatted}"
                                                   TextColor="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="4" Text="{Binding GainFormatted}"
                                               TextColor="{Binding GainColour}"
                                               FontSize="12" VerticalOptions="Center"
                                               WidthRequest="75"
                                               HorizontalTextAlignment="End" />
                                        <Label Grid.Column="5" Text="{Binding ChangeFormatted}"
                                               TextColor="{Binding ChangeColour}"
                                               FontSize="11" VerticalOptions="Center"
                                               WidthRequest="55"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <!-- Right: Summary panel -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Spacing="12">

                <!-- Allocation by sector -->
                <Border x:Name="SectorCard" Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Sector Allocation" Style="{StaticResource Heading2}" />
                        <VerticalStackLayout x:Name="SectorList" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

                <!-- Top dividends -->
                <Border x:Name="DividendCard" Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Dividend Yields" Style="{StaticResource Heading2}" />
                        <VerticalStackLayout x:Name="DividendList" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

                <!-- Platform -->
                <Border x:Name="PlatformCard" Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Platform" Style="{StaticResource Heading2}" />
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="🏦" FontSize="18" VerticalOptions="Center" />
                            <Label x:Name="PlatformLabel" TextColor="{StaticResource TextSecondary}"
                                   FontSize="13" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentView>
