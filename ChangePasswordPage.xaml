<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.ChangePasswordPage"
             BackgroundColor="#0A0F1E"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Border x:Name="Card"
                BackgroundColor="#131B2E"
                Stroke="#1E2D4A"
                StrokeThickness="1"
                Padding="36,32"
                WidthRequest="440"
                VerticalOptions="Center" HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="0">
                <Label Text="Change Password" FontSize="24" FontAttributes="Bold"
                       TextColor="#F1F5F9" HorizontalOptions="Center" />
                <Label x:Name="IntroLabel" Text="Choose a new password for your SmartCube account."
                       FontSize="13" TextColor="#64748B" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Margin="0,6,0,24" />

                <Label Text="Current or temporary password" FontSize="12" TextColor="#94A3B8" Margin="0,0,0,6" />
                <Border BackgroundColor="#0A0F1E" Stroke="#1E2D4A" StrokeThickness="1" Padding="12,0" HeightRequest="44">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Entry x:Name="CurrentEntry" IsPassword="True" PlaceholderColor="#475569" TextColor="#F1F5F9"
                           BackgroundColor="Transparent" FontSize="14" VerticalOptions="Center" ReturnType="Next"
                           Completed="OnCurrentCompleted" />
                </Border>

                <Label Text="New password" FontSize="12" TextColor="#94A3B8" Margin="0,16,0,6" />
                <Border BackgroundColor="#0A0F1E" Stroke="#1E2D4A" StrokeThickness="1" Padding="12,0" HeightRequest="44">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="NewEntry" IsPassword="True" PlaceholderColor="#475569" TextColor="#F1F5F9"
                               BackgroundColor="Transparent" FontSize="14" VerticalOptions="Center" ReturnType="Next"
                               Completed="OnNewCompleted" />
                        <Button Grid.Column="1" x:Name="ShowBtn" Text="Show" BackgroundColor="Transparent"
                                TextColor="#60A5FA" FontSize="11" Padding="6,0" HeightRequest="30"
                                VerticalOptions="Center" Clicked="OnShowClicked" />
                    </Grid>
                </Border>
                <Label Text="At least 8 characters with upper and lower case, a number and a symbol."
                       FontSize="11" TextColor="#475569" Margin="0,6,0,0" LineBreakMode="WordWrap" />

                <Label Text="Confirm new password" FontSize="12" TextColor="#94A3B8" Margin="0,16,0,6" />
                <Border BackgroundColor="#0A0F1E" Stroke="#1E2D4A" StrokeThickness="1" Padding="12,0" HeightRequest="44">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Entry x:Name="ConfirmEntry" IsPassword="True" PlaceholderColor="#475569" TextColor="#F1F5F9"
                           BackgroundColor="Transparent" FontSize="14" VerticalOptions="Center" ReturnType="Go"
                           Completed="OnConfirmCompleted" />
                </Border>

                <Button x:Name="SaveBtn" Text="Change Password" FontSize="15" FontAttributes="Bold"
                        BackgroundColor="#3B82F6" TextColor="White" CornerRadius="12" HeightRequest="48"
                        Margin="0,22,0,0" Clicked="OnSaveClicked" />
                <Button x:Name="CancelBtn" Text="Cancel" FontSize="13" BackgroundColor="Transparent"
                        TextColor="#94A3B8" HeightRequest="40" Margin="0,6,0,0" Clicked="OnCancelClicked" />

                <Label x:Name="StatusLabel" Text="" FontSize="12" TextColor="#F87171"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" Margin="0,10,0,0" IsVisible="False" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
