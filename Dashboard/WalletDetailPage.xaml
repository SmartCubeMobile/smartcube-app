<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.Dashboard.WalletDetailPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource NavBg}" Padding="20,16"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" Text="← Back" BackgroundColor="Transparent"
                        TextColor="{StaticResource Accent}" FontSize="14"
                        ToolTipProperties.Text="Go back to the previous screen."
                        Clicked="OnBackClicked" Padding="0" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <Label x:Name="HeaderTitle" TextColor="{StaticResource TextPrimary}"
                           FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="HeaderSubtitle" TextColor="{StaticResource TextMuted}"
                           FontSize="11" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Button Grid.Column="2" x:Name="RefreshButton" Text="↻"
                        BackgroundColor="#1E3A5F" TextColor="#60A5FA"
                        FontSize="16" CornerRadius="8" Padding="6,0"
                        HeightRequest="32" WidthRequest="36"
                        ToolTipProperties.Text="Re-fetch the latest price for this coin and refresh the figures on this page."
                        Clicked="OnRefreshClicked" />
                <Button Grid.Column="3" Text="?" ToolTipProperties.Text="What this section does" FontSize="12" FontAttributes="Bold" WidthRequest="26" HeightRequest="26" Padding="0" CornerRadius="13" BackgroundColor="#1E2D4A" TextColor="#94A3B8" VerticalOptions="Center" Clicked="OnHelpClicked" />
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20,12">
            <VerticalStackLayout Spacing="16">

                <!-- Value Card -->
                <Border Style="{StaticResource CardFrame}" Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="TotalValue" TextColor="{StaticResource TextPrimary}"
                               FontSize="32" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Quantity" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="0" x:Name="QuantityLabel" TextColor="{StaticResource TextPrimary}" FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Current Price" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="PriceLabel" TextColor="{StaticResource TextPrimary}" FontSize="14" FontAttributes="Bold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource CardBgLight}" Margin="0,4" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="24h Change" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="0" x:Name="ChangeLabel" FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="P&amp;L (from tx history)" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="PnlLabel" FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Avg Cost Basis" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="3" Grid.Column="0" x:Name="AvgCostLabel" TextColor="{StaticResource TextPrimary}" FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="1" Text="Total Cost" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="3" Grid.Column="1" x:Name="CostBasisLabel" TextColor="{StaticResource TextPrimary}" FontSize="14" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- P&L Chart -->
                <Border Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="P&amp;L Over Time" Style="{StaticResource Heading2}" ToolTipProperties.Text="How the profit or loss on this wallet has changed over time." />
                        <GraphicsView x:Name="PnlChart" HeightRequest="180" />
                    </VerticalStackLayout>
                </Border>

                <!-- Wallet Info -->
                <Border Style="{StaticResource CardFrame}" Padding="16">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Network" TextColor="{StaticResource TextMuted}" FontSize="11" />
                        <Label Grid.Row="0" Grid.Column="1" x:Name="NetworkLabel" TextColor="{StaticResource TextPrimary}" FontSize="12" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Address" TextColor="{StaticResource TextMuted}" FontSize="11" />
                        <Label Grid.Row="1" Grid.Column="1" x:Name="AddressLabel" TextColor="{StaticResource TextPrimary}" FontSize="12" LineBreakMode="TailTruncation" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Label" TextColor="{StaticResource TextMuted}" FontSize="11" />
                        <Label Grid.Row="2" Grid.Column="1" x:Name="WalletLabelText" TextColor="{StaticResource TextPrimary}" FontSize="12" />
                    </Grid>
                </Border>

                <!-- Transaction Summary -->
                <Border Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Transaction Summary" Style="{StaticResource Heading2}" ToolTipProperties.Text="Totals for coins received, sent and the net change for this wallet." />
                            <Label Grid.Column="1" x:Name="TxCountLabel" TextColor="{StaticResource TextMuted}" FontSize="12"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0" Text="Total Received" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="0" x:Name="TotalReceived" TextColor="#22C55E" FontSize="13" FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="0" x:Name="ReceivedValue" TextColor="#64748B" FontSize="10" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Total Sent" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="TotalSent" TextColor="#EF4444" FontSize="13" FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="SentValue" TextColor="#64748B" FontSize="10" />
                            <Label Grid.Row="0" Grid.Column="2" Text="Net Flow" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="2" x:Name="NetFlow" FontSize="13" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Transaction History -->
                <Border Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Transaction History" Style="{StaticResource Heading2}" ToolTipProperties.Text="Every transaction for this wallet; use the buttons below to filter or export as PDF." />
                        <HorizontalStackLayout x:Name="FilterBar" Spacing="8" />
                        <ScrollView Orientation="Horizontal">
                            <VerticalStackLayout x:Name="TransactionsList" Spacing="4"
                                                 MinimumWidthRequest="650" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
