<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="SmartCubeMobile.UtilityExchangeRatesPopup">

    <Border Style="{StaticResource CardFrame}"
            BackgroundColor="{StaticResource CardBg}"
            Stroke="{StaticResource BorderColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="16"
            WidthRequest="360">
        <VerticalStackLayout Spacing="12">
            <Label Text="Exchange Rates"
                   Style="{StaticResource Heading2}"
                   TextColor="{StaticResource TextPrimary}" />

            <BoxView HeightRequest="1"
                     Color="{StaticResource BorderColor}" />

            <Grid x:Name="ExchangeRatesReduced"
                  RowSpacing="8"
                  ColumnSpacing="12"
                  ColumnDefinitions="*,Auto">
                <Label Text="No exchange rate data available"
                       TextColor="{StaticResource TextMuted}"
                       Grid.ColumnSpan="2"
                       HorizontalTextAlignment="Center"
                       Margin="0,12,0,0" />
            </Grid>

            <Button Text="Close"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalOptions="End"
                    Margin="0,8,0,0" />
        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
