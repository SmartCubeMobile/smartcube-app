<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCubeMobile.LoginPage"
             BackgroundColor="#0A0F1E"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">

        <Border x:Name="Card"
                Grid.Row="0"
                BackgroundColor="#131B2E"
                Stroke="#1E2D4A"
                StrokeThickness="1"
                Padding="36,32"
                WidthRequest="420"
                VerticalOptions="Center" HorizontalOptions="Center"
                Opacity="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="0">

                <Image Source="smartcube_mobile_logo_square.png"
                       WidthRequest="96" HeightRequest="96"
                       Aspect="AspectFit" HorizontalOptions="Center" />

                <Label Text="SmartCube" FontSize="28" FontAttributes="Bold"
                       TextColor="#F1F5F9" HorizontalOptions="Center" Margin="0,14,0,0" />
                <Label Text="Sign in to your account" FontSize="13"
                       TextColor="#64748B" HorizontalOptions="Center" Margin="0,4,0,26" />

                <Label Text="Username or email" FontSize="12" TextColor="#94A3B8" Margin="0,0,0,6" />
                <Border BackgroundColor="#0A0F1E" Stroke="#1E2D4A" StrokeThickness="1" Padding="12,0" HeightRequest="44">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Entry x:Name="LoginEntry" Placeholder="Username or you@example.com"
                           PlaceholderColor="#475569" TextColor="#F1F5F9" BackgroundColor="Transparent"
                           FontSize="14" VerticalOptions="Center" ReturnType="Next"
                           Completed="OnLoginCompleted" />
                </Border>

                <Label Text="Password" FontSize="12" TextColor="#94A3B8" Margin="0,16,0,6" />
                <Border BackgroundColor="#0A0F1E" Stroke="#1E2D4A" StrokeThickness="1" Padding="12,0" HeightRequest="44">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Password"
                               PlaceholderColor="#475569" TextColor="#F1F5F9" BackgroundColor="Transparent"
                               FontSize="14" VerticalOptions="Center" ReturnType="Go"
                               Completed="OnPasswordCompleted" />
                        <Button Grid.Column="1" x:Name="ShowPasswordBtn" Text="Show"
                                BackgroundColor="Transparent" TextColor="#60A5FA"
                                FontSize="11" Padding="6,0" HeightRequest="30"
                                VerticalOptions="Center" Clicked="OnShowPasswordClicked" />
                    </Grid>
                </Border>

                <HorizontalStackLayout Spacing="6" Margin="0,14,0,0">
                    <CheckBox x:Name="RememberCheck" IsChecked="True" Color="#3B82F6" VerticalOptions="Center" />
                    <Label Text="Remember this device" FontSize="13" TextColor="#CBD5E1" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRememberLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Button x:Name="SignInBtn" Text="Sign In"
                        FontSize="15" FontAttributes="Bold"
                        BackgroundColor="#3B82F6" TextColor="White"
                        CornerRadius="12" HeightRequest="48"
                        Margin="0,20,0,0"
                        Clicked="OnSignInClicked" />

                <Label x:Name="StatusLabel" Text="" FontSize="12"
                       TextColor="#F87171" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                       Margin="0,12,0,0" IsVisible="False" />

                <BoxView HeightRequest="1" Color="#1E2D4A" Margin="0,22,0,16" />

                <Label Text="Forgot your password?" FontSize="13" TextColor="#60A5FA" HorizontalOptions="Center" Margin="0,0,0,10">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="New to SmartCube?" FontSize="13" TextColor="#64748B" />
                    <Label Text="Create an account" FontSize="13" TextColor="#60A5FA" FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateAccountTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="4" HorizontalOptions="Center" Margin="0,0,0,28">
            <Label Text="Created by" FontSize="11" TextColor="#475569" HorizontalOptions="Center" />
            <Label Text="Keasdon Energy" FontSize="14" FontAttributes="Bold" TextColor="#64748B" HorizontalOptions="Center" />
            <Label x:Name="ServerLabel" Text="" FontSize="10" TextColor="#475569"
                   HorizontalOptions="Center" Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnServerTapped" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
